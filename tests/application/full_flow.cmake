# Launch the real application in distinct processes through its public CLI.
file(MAKE_DIRECTORY "${SCRATCH}")
set(save "${SCRATCH}/player.sav")
file(REMOVE "${save}")
function(run_game name commands expected_exit expected_text)
    set(input "${SCRATCH}/${name}.txt")
    file(WRITE "${input}" "${commands}")
    execute_process(COMMAND "${APP}" --content "${CONTENT}" --save "${save}" --script "${input}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
    file(WRITE "${SCRATCH}/${name}.log" "${output}\n${errors}")
    if(NOT "${result}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "${name}: exit ${result}, wanted ${expected_exit}\n${output}\n${errors}")
    endif()
    if(NOT "${output}${errors}" MATCHES "${expected_text}")
        message(FATAL_ERROR "${name}: missing ${expected_text}\n${output}\n${errors}")
    endif()
endfunction()
run_game(partial "buy 100 1\naccept 1\ninspect 7\ntalk 5001\nnext\nsave\nquit\n" 0 "准备好出发了吗")
run_game(resume "dialogue\nchoose 20\nfinish\nclaim 1\nsave\nstatus\nquests\nquit\n" 0 "已领奖")
file(READ "${SCRATCH}/resume.log" resumed)
if(NOT resumed MATCHES "金币：500" OR NOT resumed MATCHES "药水 \\[1001\\] × 7")
    message(FATAL_ERROR "Final assets wrong: ${resumed}")
endif()
# IDs continue after restart; a new purchase must execute, not conflict or replay.
run_game(new_purchase "buy 200 1\nsave\nquit\n" 0 "金币：450")
file(SHA256 "${save}" before)
run_game(reclaim "claim 1\n" 1 "already_claimed")
file(SHA256 "${save}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Rejected claim changed the save")
endif()
# Wrong option should be rejected without ending the interactive session.
file(WRITE "${SCRATCH}/interactive.txt" "buy 100 -1\nstatus\nquit\n")
execute_process(COMMAND "${APP}" --content "${CONTENT}" --save "${save}"
    INPUT_FILE "${SCRATCH}/interactive.txt" RESULT_VARIABLE result OUTPUT_VARIABLE output TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT output MATCHES "参数必须是正整数" OR NOT output MATCHES "金币：450")
    message(FATAL_ERROR "Interactive input recovery failed: ${output}")
endif()
file(WRITE "${save}" "broken-archive")
file(SHA256 "${save}" before)
run_game(corrupt "status\nquit\n" 1 "已有存档恢复失败")
file(SHA256 "${save}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Corrupt save was overwritten")
endif()
# Configuration failure must not silently start a new player or rewrite a save.
file(MAKE_DIRECTORY "${SCRATCH}/bad-content")
file(WRITE "${SCRATCH}/bad-content/game.json" "{}")
execute_process(COMMAND "${APP}" --content "${SCRATCH}/bad-content" --save "${save}"
    --script "${SCRATCH}/corrupt.txt"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 1 OR NOT errors MATCHES "启动失败")
    message(FATAL_ERROR "Invalid configuration was not rejected")
endif()
file(SHA256 "${save}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Invalid config changed the save")
endif()
message(STATUS "Real app: purchase, accept, inspect, interrupted dialogue, restart, claim, save and failure recovery passed")
